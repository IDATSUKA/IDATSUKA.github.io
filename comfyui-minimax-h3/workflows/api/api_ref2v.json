{
  "1": {
    "class_type": "LoadImage",
    "_meta": { "title": "image_1 -> referred to as 'Image 1' in the prompt" },
    "inputs": { "image": "example.png" }
  },
  "2": {
    "class_type": "MinimaxHailuo03ReferenceNode",
    "_meta": { "title": "MiniMax H3 Reference to Video (hosted API)" },
    "inputs": {
      "model": "MiniMax H3",
      "model.prompt": "Image 1 walks through a sunlit forest path, leaves crunching underfoot, birdsong in the background.",
      "model.resolution": "768P",
      "model.ratio": "adaptive",
      "model.duration": 5,
      "model.reference_images.image_1": ["1", 0],
      "seed": 42,
      "watermark": false
    }
  },
  "3": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["2", 0],
      "filename_prefix": "minimax_h3_api/ref2v",
      "format": "mp4",
      "codec": "auto"
    }
  }
}
