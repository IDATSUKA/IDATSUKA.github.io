    "inputs": { "image": "example.png" }
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": { "title": "last_frame (optional - delete this node for i2v)" },
    "inputs": { "image": "example.png" }
  },
  "3": {
    "class_type": "MinimaxHailuo03FirstLastFrameNode",
