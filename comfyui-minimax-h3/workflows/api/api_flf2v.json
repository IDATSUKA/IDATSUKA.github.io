      "watermark": false
    }
  },
  "4": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["3", 0],
      "filename_prefix": "minimax_h3_api/flf2v",
      "format": "mp4",
      "codec": "auto"
    }
  }
