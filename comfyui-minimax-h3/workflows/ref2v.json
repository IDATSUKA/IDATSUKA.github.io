{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "MiniMax H3 DiT (ref2va)" },
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL-32B (MiniMax H3 text encoder)" },
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Video VAE" },
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": { "title": "Audio VAE" },
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "5": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": ["1", 0],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "14": {
    "class_type": "LoadImage",
    "_meta": { "title": "ref_image_0 -> <Picture 1>" },
    "inputs": { "image": "example.png" }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": { "title": "ref2va conditioning" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "<Picture 1> walks through a sunlit forest path, leaves crunching underfoot, birdsong in the background.",
      "width": 1344,
      "height": 768,
      "length": 124,
      "ref_image_size": "match",
      "ref_image_0": ["14", 0]
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["6", 0] }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["6", 1],
      "seed": 0,
      "steps": 50,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": { "av_latent": ["8", 0] }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["3", 0] }
  },
  "11": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["9", 1], "vae": ["4", 0] }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["10", 0],
      "fps": 24.0,
      "audio": ["11", 0]
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "minimax_h3/ref2v",
      "format": "mp4",
      "codec": "auto"
    }
  }
}
