<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enables Chrome DevTools for the panel. With the extension installed and the
  host application running, open http://localhost:8088 (Premiere) in a browser
  to inspect the panel's console.
-->
<ExtensionList>
  <Extension Id="com.idatsuka.adobebridge.panel">
    <HostList>
      <Host Name="PPRO" Port="8088"/>
      <Host Name="AEFT" Port="8089"/>
      <Host Name="PHXS" Port="8090"/>
      <Host Name="PHXM" Port="8090"/>
      <Host Name="ILST" Port="8091"/>
      <Host Name="AUDT" Port="8092"/>
    </HostList>
  </Extension>
</ExtensionList>
